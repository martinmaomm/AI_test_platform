# 开发环境推荐配置
DEBUG=True
DJANGO_SECRET_KEY=dev-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,::1, *

# 登录记录的可信代理 IP/CIDR，逗号分隔；默认仅信任本机 Vite/反向代理。
# 跨机器部署代理时按实际对端精确配置，禁止使用 * 或全网地址段。
# 外层代理必须正确覆盖/追加 X-Forwarded-For；直接启动 Uvicorn 需加 --no-proxy-headers。
LOGIN_RECORD_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# 通知消息中的平台报告链接地址。部署时改成收件人能访问的前端域名或局域网地址，
# 不要填后端 API 地址，也不要把 localhost 发给其他设备上的用户。
# 修改后重启 Django 和 Celery Worker；不会替你更改现有 .env。
FRONTEND_BASE_URL=http://127.0.0.1:5173

# MySQL/MariaDB 数据库配置。请替换为目标实例的独立应用账户，
# 不要提交真实密码或复用生产凭据。
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=replace_with_a_strong_secret
DB_HOST=your_mysql_host
DB_PORT=3306

# 本地Redis配置
REDIS_URL=redis://localhost:6379/0

# 关闭 ChromaDB / mcp-use 的匿名遥测，避免 PostHog 上报失败时反复打印 SSL 重试日志
# 修改后需要重启 Django 和 Celery Worker 才会生效
ANONYMIZED_TELEMETRY=FALSE
MCP_USE_ANONYMIZED_TELEMETRY=false

# 第三方 LLM API 默认请求超时时间（秒）；模型配置中的 extra_config.timeout 可以单独覆盖
LLM_TIMEOUT_SECONDS=300

# API 工作区单场景“生成并验证”的执行期限（秒），从 worker 开始处理计时，不含排队。
# 与上面的单次 LLM 请求超时独立；修改后重启后端和 Celery。
# 任务过期不会撤销远端已执行的操作；静默模型请求仍受其单次请求超时约束。
API_GENERATION_TIMEOUT_SECONDS=1800
# 一批多个场景的总执行期限（含规划与串行子场景），与每个场景时限同时生效。
API_GENERATION_BATCH_TIMEOUT_SECONDS=7200
# 尚未被 worker 领取的排队期限；避免 worker 未启动时无限等待。
API_GENERATION_QUEUE_TIMEOUT_SECONDS=1800

# 从网页探索采集 API（默认关闭）。启用前需要用户自有的固定 Playwright MCP 1.0.12 配置；
# 原始 JSONL 只写入 backend/logs/api-browser-discovery/，不经 MEDIA 对外提供。
API_BROWSER_DISCOVERY_ENABLED=false
# 总探索时限 60-1800 秒；模型/MCP 工具、网络证据和正文存储各自独立限额。
API_BROWSER_DISCOVERY_TOTAL_TIMEOUT_SECONDS=900
API_BROWSER_DISCOVERY_MAX_MODEL_STEPS=100
API_BROWSER_DISCOVERY_MAX_TOOL_CALLS=100
API_BROWSER_DISCOVERY_MAX_REQUESTS=500
API_BROWSER_DISCOVERY_MAX_BODY_BYTES=262144
API_BROWSER_DISCOVERY_MAX_TOTAL_BYTES=20971520
# worker 超过此间隔未持久化 checkpoint 时任务会显示 heartbeat_expired。
API_BROWSER_DISCOVERY_HEARTBEAT_LEASE_SECONDS=45

# 项目知识库（手工测试用例、知识问答），不影响原 API RAG / WebUI 自动化脚本
PROJECT_KNOWLEDGE_ENABLED=true
# worker 开始工作后的总时限，不含排队；30-1500秒，默认1200
KNOWLEDGE_TOTAL_TIMEOUT_SECONDS=1200

# WebUI 页面探索总时限（秒，包含同会话定向补充）；仅影响页面探索阶段。
# 与 LLM_TIMEOUT_SECONDS（单次 LLM 请求超时）独立；未设置或非法时回退 600，范围限制为 60-1800。
WEBUI_EXPLORATION_TOTAL_TIMEOUT_SECONDS=600

# WebUI 生成 worker 独立心跳（秒）。不是单次模型请求超时，也不延长探索总时限。
WEBUI_GENERATION_HEARTBEAT_INTERVAL_SECONDS=15
# 仅已领取任务参与失联判断；至少为心跳间隔的3倍。未领取的排队任务不会自动重放。
WEBUI_GENERATION_STALE_TIMEOUT_SECONDS=120
# 关键浏览器动作后附带页面观察（计入原工具预算）；false 可关闭自动观察。
WEBUI_EXPLORATION_AUTO_OBSERVE=true
# 发给模型的历史消息软上限（字符，不是 token）；原始描述、最近页面和最近两轮保留，可能超限。
WEBUI_EXPLORATION_CONTEXT_CHARS=48000

# Node MCP Playwright 1.57.0 浏览器缓存（chromium-1200）
# 相对路径按 backend 根目录解析；也可以填写绝对路径
MCP_PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers
# Python Playwright 浏览器缓存；留空时使用系统默认缓存目录
# 如需项目内缓存，可填写 .python-playwright-browsers
PYTHON_PLAYWRIGHT_BROWSERS_PATH=

# 性能测试执行：独立控制器，不由 Celery 发压。管理计划/节点不需要启用。
# 配置完后运行 python manage.py run_performance_controller；修改需重启控制器与后端。
PERFORMANCE_EXECUTION_ENABLED=false
# 加密 RPC 入口，原始 Locust RPC 始终只绑定回环地址。不要向公网暴露原生 RPC。
PERFORMANCE_RPC_BIND_HOST=127.0.0.1
PERFORMANCE_RPC_PORT=9443
# 填节点能连接的主机名/IP及 TLS 证书名称；不要填 URL、路径或账号。
PERFORMANCE_RPC_PUBLIC_HOST=
PERFORMANCE_RPC_SERVER_NAME=
# stunnel 须单独安装；macOS Homebrew 也可填 /opt/homebrew/bin/stunnel。
PERFORMANCE_STUNNEL_BINARY=stunnel
# 可选：独立控制器私有目录，目录权限必须0700；默认 backend/temp/performance-runtime。
# PERFORMANCE_RUNTIME_DIR=/absolute/private/performance-runtime

# 一键接入：节点可访问的 HTTPS 入口（不可直接填前端 Vite 地址）
PERFORMANCE_NODE_PUBLIC_URL=
# 公共发行目录，仅放受控发布工具生成的镜像和 manifest；不放密钥或 .env。
# 同一路径需要配置到 Caddy 的 PERFORMANCE_NODE_RELEASE_DIR。
# PERFORMANCE_NODE_RELEASE_DIR=/absolute/path/backend/resource/performance-node
# 使用私有 CA 时，仅填 CA 公钥证书；留空则使用节点操作系统的可信 CA。
# PERFORMANCE_NODE_CA_CERT_FILE=/absolute/private/gateway/storage/pki/authorities/local/root.crt
