# 开发环境推荐配置
DEBUG=True
DJANGO_SECRET_KEY=dev-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,::1, *

# 通知消息中的平台报告链接地址。部署时改成收件人能访问的前端域名或局域网地址，
# 不要填后端 API 地址，也不要把 localhost 发给其他设备上的用户。
# 修改后重启 Django 和 Celery Worker；不会替你更改现有 .env。
FRONTEND_BASE_URL=http://127.0.0.1:5173

# 数据库配置（SQLite - 开发环境默认）
# 无需额外配置，SQLite数据库文件会自动创建

# 本地Redis配置
REDIS_URL=redis://localhost:6379/0

# 关闭 ChromaDB / mcp-use 的匿名遥测，避免 PostHog 上报失败时反复打印 SSL 重试日志
# 修改后需要重启 Django 和 Celery Worker 才会生效
ANONYMIZED_TELEMETRY=FALSE
MCP_USE_ANONYMIZED_TELEMETRY=false

# 第三方 LLM API 默认请求超时时间（秒）；模型配置中的 extra_config.timeout 可以单独覆盖
LLM_TIMEOUT_SECONDS=300

# API 工作区“生成并验证”的整个任务期限（秒），最多三轮生成/修复与试运行。
# 与上面的单次 LLM 请求超时独立；修改后重启后端和 Celery。
# 任务过期不会撤销远端已执行的操作；静默模型请求仍受其单次请求超时约束。
API_GENERATION_TIMEOUT_SECONDS=1800

# 从网页探索采集 API（默认关闭）。启用前需要用户自有的固定 Playwright MCP 1.0.12 配置；
# 原始 JSONL 只写入 backend/logs/api-browser-discovery/，不经 MEDIA 对外提供。
API_BROWSER_DISCOVERY_ENABLED=false
# 总探索时限 60-1800 秒；模型/MCP 工具、网络证据和正文存储各自独立限额。
API_BROWSER_DISCOVERY_TOTAL_TIMEOUT_SECONDS=900
API_BROWSER_DISCOVERY_MAX_MODEL_STEPS=100
API_BROWSER_DISCOVERY_MAX_TOOL_CALLS=100
API_BROWSER_DISCOVERY_MAX_REQUESTS=500
API_BROWSER_DISCOVERY_MAX_BODY_BYTES=262144
API_BROWSER_DISCOVERY_MAX_TOTAL_BYTES=20971520
# worker 超过此间隔未持久化 checkpoint 时任务会显示 heartbeat_expired。
API_BROWSER_DISCOVERY_HEARTBEAT_LEASE_SECONDS=45

# 项目知识库（手工测试用例、知识问答），不影响原 API RAG / WebUI 自动化脚本
PROJECT_KNOWLEDGE_ENABLED=true
# worker 开始工作后的总时限，不含排队；30-1500秒，默认1200
KNOWLEDGE_TOTAL_TIMEOUT_SECONDS=1200

# WebUI 页面探索总时限（秒，包含同会话定向补充）；仅影响页面探索阶段。
# 与 LLM_TIMEOUT_SECONDS（单次 LLM 请求超时）独立；未设置或非法时回退 600，范围限制为 60-1800。
WEBUI_EXPLORATION_TOTAL_TIMEOUT_SECONDS=600

# Node MCP Playwright 1.57.0 浏览器缓存（chromium-1200）
# 相对路径按 backend 根目录解析；也可以填写绝对路径
MCP_PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers
# Python Playwright 浏览器缓存；留空时使用系统默认缓存目录
# 如需项目内缓存，可填写 .python-playwright-browsers
PYTHON_PLAYWRIGHT_BROWSERS_PATH=

# 文件上传大小限制（10MB）
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
