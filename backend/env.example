# 开发环境推荐配置
DEBUG=True
DJANGO_SECRET_KEY=dev-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,::1, *

# 数据库配置（SQLite - 开发环境默认）
# 无需额外配置，SQLite数据库文件会自动创建

# 本地Redis配置
REDIS_URL=redis://localhost:6379/0

# 关闭 ChromaDB / mcp-use 的匿名遥测，避免 PostHog 上报失败时反复打印 SSL 重试日志
# 修改后需要重启 Django 和 Celery Worker 才会生效
ANONYMIZED_TELEMETRY=FALSE
MCP_USE_ANONYMIZED_TELEMETRY=false

# 第三方 LLM API 默认请求超时时间（秒）；模型配置中的 extra_config.timeout 可以单独覆盖
AITS_LLM_TIMEOUT_SECONDS=300

# WebUI 页面探索总时限（秒，包含同会话定向补充）；适合响应较慢的第三方模型
# 未设置时沿用 AITS_LLM_TIMEOUT_SECONDS；不提高浏览器工具或模型调用次数上限
WEBUI_EXPLORATION_TOTAL_TIMEOUT_SECONDS=600

# Node MCP Playwright 1.57.0 浏览器缓存（chromium-1200）
# 相对路径按 backend 根目录解析；也可以填写绝对路径
MCP_PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers
# Python Playwright 浏览器缓存；留空时使用系统默认缓存目录
# 如需项目内缓存，可填写 .python-playwright-browsers
PYTHON_PLAYWRIGHT_BROWSERS_PATH=

# 文件上传大小限制（10MB）
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
