# ========================================
# AITS System .gitignore
# ========================================

# 1. 核心隐私与数据 (本地必须保留，严禁上传 GitHub)
backend/.env
backend/db.sqlite3
backend/chroma_db/

# 2. 运行时生成的缓存与工作区 (可以删，系统会自动重建，严禁上传)
backend/.idea/
backend/httprunner_workspace/
backend/playwright_workspace/
backend/.playwright-browsers/
backend/logs/
backend/temp/
backend/media/

# 2.1 Python 全局编译缓存 (强烈建议全局拦截，而不仅限 backend 根目录)
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# 3. 前端庞大的依赖包与构建产物 (可以删，npm install 会重建，严禁上传)
frontend/node_modules/
# 3.1 前端打包生成的静态资源目录 (通常不需要提交源码库)
frontend/dist/
frontend/build/

# 4. 本地环境可执行工具 (视团队规范而定，通常不上传)
backend/allure-2.23.0/

# 5. IDE & 本地工具缓存
.cursor/
.playwright-mcp/
.vscode/

# 6. 本地运行日志与临时调试快照 (拦截你之前 status 里的多余文件)
*.log
backend/login_snapshot.md
backend/register_page*.md

# 7. 操作系统自动生成的垃圾文件
.DS_Store
Thumbs.db
